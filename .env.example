# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🚀 StudyForge Environment Variables
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📊 DATABASE (Required)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PostgreSQL connection string
#
# Railway: Add PostgreSQL plugin, copy DATABASE_URL from plugin variables
# Format: postgresql://user:password@host:port/database
#
DATABASE_URL="postgresql://postgres:password@postgres.railway.internal:5432/railway"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔐 NEXTAUTH (Required)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# NextAuth requires a secret for JWT encryption
#
# Generate with: openssl rand -base64 32
# Or online at: https://generate-secret.vercel.app/32
#
NEXTAUTH_SECRET="your-super-secret-key-here-generate-with-openssl"

# Application URL (auto-detected on Railway, but can be set manually)
#
# Railway: Optional - will auto-detect from RAILWAY_PUBLIC_DOMAIN
# Local: http://localhost:3000
# Production: https://your-app.up.railway.app
#
NEXTAUTH_URL="https://study-forge-production-1b4e.up.railway.app"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔑 GOOGLE OAUTH (Required for Calendar Sync)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Get credentials from Google Cloud Console
#
# Setup Steps:
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorized redirect URI:
#    https://study-forge-production-1b4e.up.railway.app/api/auth/callback/google
# 4. Copy Client ID and Client Secret below
#
GOOGLE_CLIENT_ID="123456789-abcdefghijklmnop.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-abcdefghijklmnopqrstuvwx"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔧 OPTIONAL VARIABLES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# These are set automatically by Railway, no need to configure manually
#
# PORT=3000                              # Auto-set by Railway
# NODE_ENV=production                    # Auto-set by Railway
# RAILWAY_PUBLIC_DOMAIN=your-app.railway.app  # Auto-set by Railway

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📝 PRODUCTION CHECKLIST
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Before deploying to Railway:
#
# ✅ Add PostgreSQL plugin to your Railway project
# ✅ Copy DATABASE_URL from PostgreSQL plugin variables
# ✅ Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# ✅ Create Google OAuth credentials (see above)
# ✅ Add redirect URI: https://YOUR-APP.up.railway.app/api/auth/callback/google
# ✅ Copy GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
# ✅ Set NEXTAUTH_URL to your Railway app URL
# ✅ Enable Google Calendar API in Google Cloud Console
#
# All variables are added in Railway dashboard under:
# Project → Variables → RAW Editor
